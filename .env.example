# Wymagane w produkcji. Wygeneruj SECRET_KEY poleceniem:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Jedno konto administratora. Hash wygeneruj:
# python app.py hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Klucz szyfrowania tokenów Google w bazie (Fernet):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Ustaw true za HTTPS. Lokalnie pod http://127.0.0.1:5000 ustaw false.
COOKIE_SECURE=true
DATABASE_PATH=instance/cloudvault.sqlite3
# Lokalnie SQLite; na Render ustaw DATABASE_URL (np. URL PostgreSQL z Neon).
DATABASE_URL=
MAX_UPLOAD_MB=500
# Render nie hostuje MEGAcmd na planie Free. Włączaj tylko na własnym VPS-ie.
MEGA_ENABLED=true

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://twoja-domena.example/oauth/google/callback

# MEGAcmd musi być zalogowany na tym samym koncie systemowym co aplikacja.
# Uruchom w MEGAcmdShell: webdav /
# Skopiuj wyświetlony lokalny adres; nie wystawiaj WebDAV do internetu.
MEGA_WEBDAV_URL=
# Opcjonalna ręcznie skonfigurowana wolna przestrzeń (bajty), używana przez auto-wybór.
# WebDAV MEGAcmd nie udostępnia wiarygodnego limitu konta.
MEGA_FREE_BYTES=
